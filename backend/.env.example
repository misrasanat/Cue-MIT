# Dedicated Google AI Studio API Key for Cue Card Generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
PORT=5001

# Meta Model API key for Team Brain answers (get one at ai.developer.meta.com). Never commit the real key.
META_API_KEY=your_meta_api_key_here
# Spending limit for the whole team, in US dollars, and who to email when it is reached.
LLM_BUDGET_USD=25
LLM_DAILY_USD=5
BUDGET_ALERT_EMAILS=you@example.com,teammate@example.com
# Email account used to send that alert (Gmail needs an "app password"):
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
