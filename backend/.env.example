# Dedicated Google AI Studio API Key for Cue Card Generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
PORT=5001

# Meta Model API key for Team Brain answers (get one at ai.developer.meta.com). Never commit the real key.
META_API_KEY=your_meta_api_key_here
# Spending limit for the whole team, in US dollars, and who to email when it is reached.
LLM_BUDGET_USD=25
LLM_DAILY_USD=5
BUDGET_ALERT_EMAILS=you@example.com,teammate@example.com
# Email account used to send that alert (Gmail needs an "app password"):
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password

# --- Only for a public server (Render). Leave these out on your own computer. ---
# CUE_PUBLIC_MODE=1                       # switches off routes that are only safe locally (also automatic on Render)
# PUBLIC_APP_URL=https://your-site.netlify.app   # used to build invite links
# ALLOWED_ORIGINS=https://your-site.netlify.app  # the only website allowed to call this server
# Logins are verified automatically with Supabase's public keys. Only projects on the OLDER shared-secret keys
# also need:  SUPABASE_JWT_SECRET=...  (Supabase > Project Settings > API > JWT Secret)
